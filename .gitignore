# Local secrets and generated dev stack (never commit)
.env
.env.*
!.env.example
!**/env.example

# Agentic local dev (regenerated by `agentic dev up`)
**/.agentic/

# Session / workspace state
**/.migration_workspace/
**/.agentic/migration-sessions/

# Python
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.python-version
**/.mypy_cache/
**/.pytest_cache/
**/.pyright/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# OS / editor
.DS_Store

# Optional local compose from agentic (not the postgres demo compose)
**/docker-compose.yml
