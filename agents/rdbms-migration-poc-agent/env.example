# Copy to .env in this directory (gitignored). Used by `agentic dev up` and headless CLI.
# See ../../docs/architecture.md for multi-agent state vs migration target.

# --- Migration target (deterministic runner: load PoC data) ---
# Local agentic dev: often auto-provided; override here if needed.
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/
MONGODB_URI=
MIGRATION_TARGET_DB=commerce_poc

# --- Shared PoC pack state (MongoDB workspace when set) ---
# Artifacts (discovery, plan, HITL) go here — separate DB from migration target data.
# Required for multi-agent handoff on the same engagement/session.
MIGRATION_STATE_MONGODB_URI=
MIGRATION_STATE_DB=migration_poc_state
# If you only set MONGODB_URI, leave MIGRATION_STATE_MONGODB_URI empty unless you
# intentionally want the same cluster with a different database name above.

# --- Source PostgreSQL (demo after scripts/seed-postgres-demo.sh) ---
# agentic dev (Docker): host.docker.internal — native CLI on host: localhost
POSTGRES_URI=postgresql://commerce:commerce@host.docker.internal:5433/commerce_demo

# --- Session file workspace (single-agent dev; not shared across hosts) ---
# MIGRATION_WORKSPACE_DIR=.agentic/migration-sessions

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=
